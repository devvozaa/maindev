<style>
  .reveal { opacity: 0; transform: translateY(30px); transition: all 1s ease-out; }
  .reveal.active { opacity: 1; transform: translateY(0); }

  .carousel-container {
    mask-image: linear-gradient(to right, transparent, black 10%, black 90%, transparent);
    -webkit-mask-image: linear-gradient(to right, transparent, black 10%, black 90%, transparent);
  }

  .carousel-slide {
    transition: opacity 0.7s cubic-bezier(0.25, 1, 0.5, 1),
                transform 0.7s cubic-bezier(0.25, 1, 0.5, 1);
  }
</style>

<script>
  // ── REVEAL ──────────────────────────────────────────────────
  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) entry.target.classList.add('active');
    });
  }, { threshold: 0.1 });
  document.querySelectorAll('.reveal').forEach(el => observer.observe(el));

  // ── COUNT-UP ─────────────────────────────────────────────────
  const statsSection = document.getElementById('stats-section')!;
  let counted = false;
  const statsObserver = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting && !counted) {
        counted = true;
        document.querySelectorAll<HTMLElement>('.count-up').forEach(counter => {
          const target = Number(counter.dataset.target ?? 0);
          let count = 0;
          const steps = 60;
          const increment = target / steps;
          const interval = 1800 / steps;
          const update = () => {
            count += increment;
            if (count < target) {
              counter.innerText = Math.floor(count).toString();
              setTimeout(update, interval);
            } else {
              counter.innerText = target.toString();
            }
          };
          update();
        });
      }
    });
  }, { threshold: 0.4 });
  statsObserver.observe(statsSection);

  // ── INFINITE CAROUSEL ────────────────────────────────────────
  const track = document.getElementById('carousel-track') as HTMLElement;
  const container = document.querySelector('.carousel-container') as HTMLElement;
  const originalSlides = Array.from(document.querySelectorAll<HTMLElement>('.carousel-slide'));
  const totalOriginal = originalSlides.length;

  originalSlides.forEach(slide => {
    const before = slide.cloneNode(true) as HTMLElement;
    const after  = slide.cloneNode(true) as HTMLElement;
    before.setAttribute('aria-hidden', 'true');
    after.setAttribute('aria-hidden', 'true');
    track.insertBefore(before, track.firstChild);
    track.appendChild(after);
  });

  const allSlides = Array.from(track.querySelectorAll<HTMLElement>('.carousel-slide'));
  let currentIndex = totalOriginal;
  let isTransitioning = false;

  function getSlideWidth() { return allSlides[0].offsetWidth + 40; }

  function updateCarousel(animated = true) {
    const slideW = getSlideWidth();
    const containerW = container.offsetWidth;
    const offset = (containerW / 2) - (slideW / 2) - (currentIndex * slideW) + 20;
    track.style.transition = animated ? 'transform 0.7s cubic-bezier(0.25, 1, 0.5, 1)' : 'none';
    track.style.transform = `translateX(${offset}px)`;
    allSlides.forEach((slide, i) => {
      slide.style.opacity = i === currentIndex ? '1' : '0.4';
      slide.style.transform = i === currentIndex ? 'scale(1)' : 'scale(0.92)';
    });
  }

  track.addEventListener('transitionend', () => {
    isTransitioning = false;
    if (currentIndex < totalOriginal) { currentIndex += totalOriginal; updateCarousel(false); }
    else if (currentIndex >= totalOriginal * 2) { currentIndex -= totalOriginal; updateCarousel(false); }
  });

  document.getElementById('next-btn')?.addEventListener('click', () => {
    if (isTransitioning) return;
    isTransitioning = true; currentIndex++; updateCarousel();
  });
  document.getElementById('prev-btn')?.addEventListener('click', () => {
    if (isTransitioning) return;
    isTransitioning = true; currentIndex--; updateCarousel();
  });

  window.addEventListener('load', () => updateCarousel(false));
  window.addEventListener('resize', () => updateCarousel(false));
</script>