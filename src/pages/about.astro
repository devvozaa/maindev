---
import Layout from '../layouts/Layout.astro';
import WhyChooseUsClient from '../components/WhyChooseUsClient.astro';
import PreventiveHealthIntro from '../components/Investors.astro';
---

<Layout title="About Us | Everkind Consumers">
  <main class="bg-(--color-everkind-bg) text-(--color-everkind-dark)">
    <section class="mx-auto flex min-h-[82vh] max-w-6xl flex-col items-center justify-center px-6 py-28 text-center sm:px-12 md:px-16 lg:px-24">
      <p class="mb-8 text-xs font-bold uppercase tracking-[0.3em] text-(--color-everkind-green)" style="font-family: var(--font-sans);">About Everkind</p>
      <h1 class="max-w-5xl text-5xl leading-[0.98] tracking-[-0.045em] sm:text-6xl md:text-8xl" style="font-family: var(--font-serif);">
        Health isn't something you find in a crisis.
        <span class="mt-3 block italic font-light text-(--color-everkind-green)">It's something you build every single day.</span>
      </h1>
      <div class="mt-12 border-t border-(--color-everkind-dark)/15 pt-7">
        <p class="text-3xl font-bold italic tracking-tight text-(--color-everkind-green) sm:text-4xl" style="font-family: var(--font-serif);">ever·kind</p>
        <p class="mt-2 text-sm leading-relaxed text-(--color-everkind-midgrey) sm:text-base" style="font-family: var(--font-sans);">Designed around real life stages, families &amp; everything in between.</p>
      </div>
    </section>

    <section class="bg-(--color-everkind-lightgrey) px-6 py-20 sm:px-12 md:px-16 lg:px-24 lg:py-28">
      <div class="mx-auto max-w-6xl">
        <div class="mb-10 max-w-3xl">
          <p class="mb-4 text-xs font-bold uppercase tracking-[0.3em] text-(--color-everkind-green)" style="font-family: var(--font-sans);">How we operate</p>
          <h2 class="text-4xl leading-tight tracking-tight sm:text-5xl md:text-6xl" style="font-family: var(--font-serif);">Sharper by design.</h2>
          <p class="mt-5 max-w-2xl text-base leading-relaxed text-(--color-everkind-darkgrey) sm:text-lg" style="font-family: var(--font-sans);">Insight, experiment, course-correct and scale. The same four moves, run faster than a team can, on a loop that never stops testing.</p>
        </div>
        <div class="grid gap-4 md:grid-cols-3">
          <article class="rounded-[1.5rem] bg-white p-6 sm:p-8">
            <div class="mb-10 flex items-center justify-between"><span class="text-xs font-bold text-(--color-everkind-green)">01</span><span class="h-2.5 w-2.5 rounded-full bg-[#ddb04a]"></span></div>
            <h3 class="text-3xl leading-tight" style="font-family: var(--font-serif);">Sharpened ICP</h3>
            <p class="mt-4 text-sm leading-relaxed text-(--color-everkind-darkgrey)" style="font-family: var(--font-sans);">Every search term, market trend and video through-play teaches the model who actually buys &amp; stays — so the ICP sharpens with each content cycle.</p>
          </article>
          <article class="rounded-[1.5rem] bg-(--color-everkind-green) p-6 text-white sm:p-8">
            <div class="mb-10 flex items-center justify-between"><span class="text-xs font-bold text-white/70">02</span><span class="h-2.5 w-2.5 rounded-full bg-[#f5d98f]"></span></div>
            <h3 class="text-3xl leading-tight" style="font-family: var(--font-serif);">The Operating Loop</h3>
            <p class="mt-4 text-sm leading-relaxed text-white/80" style="font-family: var(--font-sans);">One engine runs every brand. It only turns in one direction — sharper.</p>
          </article>
          <article class="rounded-[1.5rem] bg-white p-6 sm:p-8">
            <div class="mb-10 flex items-center justify-between"><span class="text-xs font-bold text-(--color-everkind-green)">03</span><span class="h-2.5 w-2.5 rounded-full bg-[#ddb04a]"></span></div>
            <h3 class="text-3xl leading-tight" style="font-family: var(--font-serif);">The Process Shift</h3>
            <p class="mt-4 text-sm leading-relaxed text-(--color-everkind-darkgrey)" style="font-family: var(--font-sans);">We start with a hypothesis and let real consumer behaviour narrow it over time, but fast. AI doesn't just move faster. It sees the customer sharper.</p>
          </article>
        </div>
      </div>
    </section>

    <section class="px-6 py-20 sm:px-12 md:px-16 lg:px-24 lg:py-24">
      <PreventiveHealthIntro />
      <div class="mx-auto mt-8 max-w-6xl border-t border-(--color-everkind-dark)/10 pt-7">
        <p class="mb-3 text-xs font-bold uppercase tracking-[0.3em] text-(--color-everkind-green)" style="font-family: var(--font-sans);">Preventive health from home</p>
        <h2 class="max-w-2xl text-3xl leading-tight tracking-tight sm:text-4xl" style="font-family: var(--font-serif);">Small, consistent choices become a healthier life.</h2>
      </div>
      <div class="mt-8">
        <WhyChooseUsClient />
      </div>
    </section>
  </main>
</Layout>
