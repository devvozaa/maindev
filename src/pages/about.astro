---
import Layout from '../layouts/Layout.astro';
import WhyChooseUsClient from '../components/WhyChooseUsClient.astro';
import PreventiveHealthIntro from '../components/Investors.astro';
---

<Layout title="About Us | Everkind Consumers">
  <main class="bg-(--color-everkind-bg) text-(--color-everkind-dark)">
    <section class="mx-auto flex min-h-[78vh] max-w-6xl flex-col items-center justify-center px-6 py-32 text-center sm:px-12 md:px-16 lg:px-24">
      <p class="mb-6 text-xs font-bold uppercase tracking-[0.28em] text-(--color-everkind-green)" style="font-family: var(--font-sans);">About Everkind</p>
      <h1 class="max-w-5xl text-4xl leading-[1.08] tracking-tight sm:text-5xl md:text-7xl" style="font-family: var(--font-serif);">
        Health isn't something you find in a crisis.<br />
        <span class="italic font-light text-(--color-everkind-green)">It's something you build every single day.</span>
      </h1>
      <p class="mt-10 max-w-2xl text-lg leading-relaxed text-(--color-everkind-midgrey)" style="font-family: var(--font-sans);">
        <span class="mb-2 block text-xl font-bold italic">ever·kind</span>
        Designed around real life stages, families &amp; everything in between.
      </p>
    </section>

    <section class="bg-(--color-everkind-lightgrey) px-6 py-20 sm:px-12 md:px-16 lg:px-24 lg:py-28">
      <div class="mx-auto max-w-6xl">
        <div class="mb-12 max-w-3xl">
          <p class="mb-4 text-xs font-bold uppercase tracking-[0.28em] text-(--color-everkind-green)" style="font-family: var(--font-sans);">How we operate</p>
          <h2 class="text-4xl leading-tight tracking-tight sm:text-5xl md:text-6xl" style="font-family: var(--font-serif);">Sharper by design.</h2>
          <p class="mt-5 max-w-2xl text-base leading-relaxed text-(--color-everkind-darkgrey) sm:text-lg" style="font-family: var(--font-sans);">Insight, experiment, course-correct and scale. The same four moves, run faster than a team can, on a loop that never stops testing.</p>
        </div>
        <div class="grid gap-5 md:grid-cols-3">
          <article class="group rounded-[2rem] bg-white p-7 shadow-[0_8px_0_rgba(0,0,0,0.08)] transition-transform duration-300 hover:-translate-y-1 sm:p-9">
            <div class="mb-12 flex items-center justify-between"><span class="text-sm font-bold text-(--color-everkind-green)">01</span><span class="h-3 w-3 rounded-full bg-[#ddb04a]"></span></div>
            <h3 class="text-3xl leading-tight" style="font-family: var(--font-serif);">Sharpened ICP</h3>
            <p class="mt-5 text-sm leading-relaxed text-(--color-everkind-darkgrey)" style="font-family: var(--font-sans);">Every search term, market trend and video through-play teaches the model who actually buys &amp; stays — so the ICP sharpens with each content cycle.</p>
          </article>
          <article class="group rounded-[2rem] bg-(--color-everkind-green) p-7 text-white shadow-[0_8px_0_rgba(0,0,0,0.15)] transition-transform duration-300 hover:-translate-y-1 sm:p-9">
            <div class="mb-12 flex items-center justify-between"><span class="text-sm font-bold text-white/70">02</span><span class="h-3 w-3 rounded-full bg-[#f5d98f]"></span></div>
            <h3 class="text-3xl leading-tight" style="font-family: var(--font-serif);">The Operating Loop</h3>
            <p class="mt-5 text-sm leading-relaxed text-white/80" style="font-family: var(--font-sans);">One engine runs every brand. It only turns in one direction — sharper.</p>
          </article>
          <article class="group rounded-[2rem] bg-white p-7 shadow-[0_8px_0_rgba(0,0,0,0.08)] transition-transform duration-300 hover:-translate-y-1 sm:p-9">
            <div class="mb-12 flex items-center justify-between"><span class="text-sm font-bold text-(--color-everkind-green)">03</span><span class="h-3 w-3 rounded-full bg-[#ddb04a]"></span></div>
            <h3 class="text-3xl leading-tight" style="font-family: var(--font-serif);">The Process Shift</h3>
            <p class="mt-5 text-sm leading-relaxed text-(--color-everkind-darkgrey)" style="font-family: var(--font-sans);">We start with a hypothesis and let real consumer behaviour narrow it over time, but fast. AI doesn't just move faster. It sees the customer sharper.</p>
          </article>
        </div>
      </div>
    </section>

    <section class="px-6 py-20 sm:px-12 md:px-16 lg:px-24 lg:py-28">
      <PreventiveHealthIntro />
      <div class="mx-auto mb-10 max-w-6xl">
        <p class="mb-4 text-xs font-bold uppercase tracking-[0.28em] text-(--color-everkind-green)" style="font-family: var(--font-sans);">Preventive health from home</p>
        <h2 class="max-w-3xl text-4xl leading-tight tracking-tight sm:text-5xl" style="font-family: var(--font-serif);">Small, consistent choices become a healthier life.</h2>
      </div>
      <WhyChooseUsClient />
    </section>
  </main>
</Layout>
